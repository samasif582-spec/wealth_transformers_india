# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Render managed or Docker Compose)
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/wt_whatsapp?schema=public

# Raw postgres credentials (used by Docker Compose services)
POSTGRES_DB=wt_whatsapp
POSTGRES_USER=wt_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────
# Full Redis URL with AUTH password (Render managed or Docker Compose)
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─────────────────────────────────────────────────────────────────────────────
# JWT (RS256 asymmetric keys)
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then base64-encode each file (single line):
#   cat private.pem | base64 -w 0   (Linux/Mac)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("private.pem"))  (PowerShell)
# ─────────────────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY=BASE64_ENCODED_RSA_PRIVATE_KEY_PEM
JWT_PUBLIC_KEY=BASE64_ENCODED_RSA_PUBLIC_KEY_PEM
# Token TTLs in seconds (access=15min, refresh=7days)
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# ─────────────────────────────────────────────────────────────────────────────
# META / WHATSAPP BUSINESS API
# Source: Meta for Developers → Your App → WhatsApp → API Setup
# ─────────────────────────────────────────────────────────────────────────────
# App Secret (used for HMAC-SHA256 webhook signature verification)
META_APP_SECRET=your_meta_app_secret_here
# Permanent / System User access token
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
# Phone Number ID (not the phone number itself — found in WhatsApp API Setup)
META_PHONE_NUMBER_ID=your_phone_number_id_here
# WhatsApp Business Account ID
META_WABA_ID=your_waba_id_here
# Arbitrary string you configure in Meta Webhooks console
META_VERIFY_TOKEN=your_webhook_verify_token_here

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE R2 OBJECT STORAGE
# Source: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# ─────────────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wt-whatsapp-assets
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ─────────────────────────────────────────────────────────────────────────────
# INTERNAL API (n8n ↔ Backend authentication)
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
INTERNAL_API_SECRET=CHANGE_ME_RANDOM_32_BYTE_HEX_SECRET

# ─────────────────────────────────────────────────────────────────────────────
# SENTRY ERROR MONITORING
# Source: Sentry Dashboard → Settings → Projects → Client Keys (DSN)
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN_BACKEND=https://BACKEND_PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
VITE_SENTRY_DSN_FRONTEND=https://FRONTEND_PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID

# ─────────────────────────────────────────────────────────────────────────────
# SMTP (for failure-rate alerts and admin notifications via nodemailer)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@wealthtrade.in
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="Wealth Trade Alerts <alerts@wealthtrade.in>"

# ─────────────────────────────────────────────────────────────────────────────
# WORKER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# BullMQ campaign worker concurrency (integer 1–100, default 10)
WORKER_CONCURRENCY=10
# Meta API messages-per-second rate limit for your WABA tier (default 80)
META_MESSAGES_PER_SECOND=80

# ─────────────────────────────────────────────────────────────────────────────
# MEDIA / STORAGE LIMITS
# ─────────────────────────────────────────────────────────────────────────────
# Maximum total media storage per organization in bytes (default 10 GB)
STORAGE_QUOTA_BYTES=10737418240

# ─────────────────────────────────────────────────────────────────────────────
# N8N AUTOMATION ENGINE
# ─────────────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_PASSWORD
# Separate DB for n8n (same Postgres host, different database)
N8N_DB_NAME=n8n_db
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=CHANGE_ME_N8N_DB_PASSWORD
# Encryption key for n8n credentials store — generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY
# Internal backend URL (Docker service name in production)
N8N_BACKEND_URL=http://backend:3000

# ─────────────────────────────────────────────────────────────────────────────
# DOMAIN & TLS (production only)
# ─────────────────────────────────────────────────────────────────────────────
# Your production domain (used by Nginx + Let's Encrypt certbot)
DOMAIN=api.wealthtrade.in
# Email address for Let's Encrypt certificate expiry notifications
LETSENCRYPT_EMAIL=devops@wealthtrade.in

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION FLAGS
# ─────────────────────────────────────────────────────────────────────────────
# Set to 'true' in production to enforce HTTPS redirect
FORCE_HTTPS=false
# Node environment: development | production | test
NODE_ENV=development
# Backend API listen port
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite public env vars — MUST start with VITE_)
# ─────────────────────────────────────────────────────────────────────────────
# Full URL to the backend API (without trailing slash)
VITE_API_BASE_URL=http://localhost:3000/api/v1
