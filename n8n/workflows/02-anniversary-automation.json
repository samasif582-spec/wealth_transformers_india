{
  "name": "02 - Daily Anniversary Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "45 3 * * *"
            }
          ]
        }
      },
      "id": "e2f2c84b-0202-4c12-9c98-111111111111",
      "name": "Schedule Trigger (03:45 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.N8N_BACKEND_URL || 'http://localhost:3000'}}/api/v1/internal/automation/anniversary-clients",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{$env.INTERNAL_API_SECRET}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "e2f2c84b-0202-4c12-9c98-222222222222",
      "name": "Fetch Anniversary Clients",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "batchSize": 50,
        "options": {}
      },
      "id": "e2f2c84b-0202-4c12-9c98-333333333333",
      "name": "Split In Batches (50)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.N8N_BACKEND_URL || 'http://localhost:3000'}}/api/v1/internal/campaigns/batch-enqueue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{$env.INTERNAL_API_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"ANNIVERSARY\",\n  \"items\": {{JSON.stringify($input.all().map(i => i.json))}}\n}",
        "options": {}
      },
      "id": "e2f2c84b-0202-4c12-9c98-444444444444",
      "name": "Batch Enqueue Anniversary Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [950, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (03:45 UTC)": {
      "main": [
        [
          {
            "node": "Fetch Anniversary Clients",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Anniversary Clients": {
      "main": [
        [
          {
            "node": "Split In Batches (50)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split In Batches (50)": {
      "main": [
        [
          {
            "node": "Batch Enqueue Anniversary Messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Batch Enqueue Anniversary Messages": {
      "main": [
        [
          {
            "node": "Split In Batches (50)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true
}
