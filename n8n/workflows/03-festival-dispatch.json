{
  "name": "03 - Festival Campaign Dispatch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * *"
            }
          ]
        }
      },
      "id": "e3f3c84b-0303-4c12-9c98-111111111111",
      "name": "Daily Festival Check (04:00 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.N8N_BACKEND_URL || 'http://localhost:3000'}}/api/v1/internal/automation/festival-scheduled-today",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{$env.INTERNAL_API_SECRET}}"
            }
          ]
        },
        "options": {}
      },
      "id": "e3f3c84b-0303-4c12-9c98-222222222222",
      "name": "Query Today's Festival Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.campaigns && $json.campaigns.length > 0}}",
              "value2": true
            }
          ]
        }
      },
      "id": "e3f3c84b-0303-4c12-9c98-333333333333",
      "name": "Has Campaigns Scheduled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "campaigns",
        "options": {}
      },
      "id": "e3f3c84b-0303-4c12-9c98-444444444444",
      "name": "Split Campaigns",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [900, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.N8N_BACKEND_URL || 'http://localhost:3000'}}/api/v1/internal/campaigns/{{$json.id}}/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{$env.INTERNAL_API_SECRET}}"
            }
          ]
        },
        "options": {}
      },
      "id": "e3f3c84b-0303-4c12-9c98-555555555555",
      "name": "Execute Festival Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 240]
    }
  ],
  "connections": {
    "Daily Festival Check (04:00 UTC)": {
      "main": [
        [
          {
            "node": "Query Today's Festival Campaigns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Today's Festival Campaigns": {
      "main": [
        [
          {
            "node": "Has Campaigns Scheduled?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Campaigns Scheduled?": {
      "main": [
        [
          {
            "node": "Split Campaigns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Campaigns": {
      "main": [
        [
          {
            "node": "Execute Festival Campaign",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true
}
